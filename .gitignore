/app/src/selfUse/

# Existing local signing material must stay private.
/.local-secrets/

# Generated decoder licenses and synthetic test packets are supplied by CI.
/app/src/main/assets/licenses/*
!/app/src/main/assets/licenses/material-color-utilities.txt
!/app/src/main/assets/licenses/miuix-glass.txt
!/app/src/main/assets/licenses/miuix-glass-notice.txt
/app/src/androidTest/assets/tone.eac3
/app/src/androidTest/assets/tone.dts
# Generated synthetic lamp-test pattern, never a release asset.
/app/src/androidTest/assets/ambilight.mp4
